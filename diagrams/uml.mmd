classDiagram
    class CareTask {
        +title
        +duration_minutes
        +priority
    }

    class CareNoteRetriever {
        +retrieve(task_title, species)
    }

    class RetrievedNote {
        +note
        +score
    }

    class PawPalAssistant {
        +generate_schedule(pet_name, species, tasks, available_minutes, start_time)
    }

    class PlannedTask {
        +task
        +start_time
        +end_time
        +explanation
        +evidence
    }

    class CarePlan {
        +pet_name
        +species
        +scheduled
        +deferred
        +response
    }

    PawPalAssistant --> CareNoteRetriever : retrieves evidence for tasks
    PawPalAssistant --> CarePlan : generates
    CarePlan --> PlannedTask : contains
    PlannedTask --> CareTask : schedules
    PlannedTask --> RetrievedNote : uses optional evidence
    CareNoteRetriever --> RetrievedNote : returns
